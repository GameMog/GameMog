node_modules/
.next/
out/
*.log
.env*.local
data/*.db
data/*.db-*
.DS_Store
*.tsbuildinfo

# third-party source downloads for the asset library (rebuild with npm run assets:fetch)
assets-src/cache/
data/backups/

# local work that never ships (the repo is public)
# Claude Code: only shared rules and skills are committed, never a session's own files
/.claude/*
!/.claude/rules/
!/.claude/skills/
/CLAUDE.local.md
# scratch scripts, test rigs and renders
/scripts/.scratch/
/.scratch/
/scripts/kart-steer/
# trailers, stills and mockups made for review and marketing (the repo root holds no media of its own)
/*.mp4
/*.mov
/*.png
/*.jpg
/*.jpeg
/shootout-look/
/shootout-m1/
/meme-kart-doge/
/aspen-gp-lord-black-diamond/
/gamemog-dare-mockups/
# private planning notes (dated: strategy, go-to-market, capital); the product docs are undated
/docs/*-20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
# Story Kit voices: local copies of Kokoro-82M and its runtime for offline dev (npm run storykit:voice-files); a
# creator's browser downloads them from Hugging Face and jsDelivr (storykit/voices/browser-voice-pass.js)
/public/storykit/kokoro/
/public/storykit/vendor/*
# (the GPL phonemizer is served, so it is committed with its licence and source offer: vendor/gpl/SOURCE.md)
!/public/storykit/vendor/gpl/
# Story Kit world store (lib/storykit-store.ts): on the Render disk, never committed
data/storykit/
data/towns/
# Hometown tile store (lib/hometown-tiles/store.ts): on the Render disk, never committed
data/hometown/
# Hometown search screenshots and scratch output
/.scratch/

# the town builder workflow build output (deploy/town-builder/workflow-build.sh)
/.town-builder/
