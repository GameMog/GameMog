{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://gamemog.com/schema/forge/character-sheet.v2.json",
 "title": "GameMog character sheet (Character Forge v2)",
 "description": "What an LLM fills from a text description of a person. Every value is a word from a closed list or a bounded number, so no sheet can ask for a real person's face, a caricature or a broken body: compile.mjs maps the words to clamped build values. Heritage is a blend of three face/skin shapes that makes an ORIGINAL face; it is never a likeness of anyone.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "id",
  "name",
  "role",
  "identity",
  "heritage",
  "face",
  "hair",
  "facialHair",
  "wardrobe",
  "posture",
  "voice"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9-]{2,40}$",
   "description": "slug, unique within the world"
  },
  "name": {
   "type": "string",
   "maxLength": 60,
   "description": "the character's name in the story (an invented name, never a real person's)"
  },
  "role": {
   "type": "string",
   "maxLength": 80,
   "description": "their part in the story: 'doorman', 'head chef', 'the grandmother who saw it'"
  },
  "logline": {
   "type": "string",
   "maxLength": 200,
   "description": "one line a player would read about them"
  },
  "identity": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "age",
    "body",
    "heightCm",
    "build"
   ],
   "properties": {
    "age": {
     "type": "integer",
     "minimum": 16,
     "maximum": 92,
     "description": "16+ only; drives the age shape and which photo skin (young / middle / old) is used"
    },
    "body": {
     "enum": [
      "female",
      "male"
     ],
     "description": "which CC0 MakeHuman base body to shape"
    },
    "presentation": {
     "type": "string",
     "maxLength": 60,
     "description": "free text on gender presentation, for the writer and voice; does not change the mesh beyond 'body'"
    },
    "heightCm": {
     "type": "integer",
     "minimum": 140,
     "maximum": 205
    },
    "build": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "frame",
      "weight",
      "muscle"
     ],
     "properties": {
      "frame": {
       "enum": [
        "small",
        "medium",
        "broad"
       ],
       "description": "shoulder/bone frame"
      },
      "weight": {
       "enum": [
        "thin",
        "slim",
        "average",
        "stocky",
        "heavy"
       ]
      },
      "muscle": {
       "enum": [
        "soft",
        "average",
        "athletic",
        "strong"
       ]
      }
     }
    }
   }
  },
  "heritage": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "blend",
    "skin"
   ],
   "properties": {
    "note": {
     "type": "string",
     "maxLength": 120,
     "description": "the text's own words about background, kept for the writer (e.g. 'Korean', 'British-Nigerian')"
    },
    "blend": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "african",
      "asian",
      "european"
     ],
     "description": "the face and body shape blend, 0..1 each (normalised; each is kept between 0.03 and 0.9 so the face is always a blend, never one template)",
     "properties": {
      "african": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "asian": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "european": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      }
     }
    },
    "skin": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "tone",
      "undertone"
     ],
     "properties": {
      "tone": {
       "enum": [
        "very-light",
        "light",
        "light-medium",
        "medium",
        "tan",
        "brown",
        "dark-brown",
        "deep"
       ]
      },
      "undertone": {
       "enum": [
        "cool",
        "neutral",
        "warm",
        "olive"
       ]
      },
      "weathered": {
       "type": "boolean",
       "description": "outdoor / hard-working skin: a little rougher and ruddier"
      },
      "makeup": {
       "enum": [
        "none",
        "natural",
        "lipstick"
       ]
      },
      "lipTint": {
       "enum": [
        "natural",
        "rose",
        "red",
        "berry",
        "nude"
       ]
      }
     }
    }
   }
  },
  "face": {
   "type": "object",
   "additionalProperties": false,
   "description": "the face over the blend. Each word is a set of MakeHuman's CC0 face targets (forge/targets.mjs), capped at 3.5 mm a field and 12 mm in all, plus a few small marks of the character's own picked by its id: this is what makes two people of the same blend different people",
   "properties": {
    "jaw": {
     "enum": [
      "soft",
      "average",
      "square",
      "heavy"
     ]
    },
    "cheeks": {
     "enum": [
      "hollow",
      "average",
      "full",
      "jowly"
     ]
    },
    "cheekbones": {
     "enum": [
      "flat",
      "average",
      "high"
     ]
    },
    "faceWidth": {
     "enum": [
      "narrow",
      "average",
      "wide"
     ]
    },
    "nose": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "width": {
       "enum": [
        "narrow",
        "average",
        "wide"
       ]
      },
      "length": {
       "enum": [
        "short",
        "average",
        "long"
       ]
      },
      "tip": {
       "enum": [
        "upturned",
        "average",
        "drooping"
       ]
      },
      "bridge": {
       "enum": [
        "straight",
        "hump",
        "concave",
        "greek",
        "flat"
       ]
      }
     }
    },
    "browRidge": {
     "enum": [
      "soft",
      "average",
      "strong"
     ]
    },
    "chin": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "projection": {
       "enum": [
        "receding",
        "average",
        "strong"
       ]
      },
      "length": {
       "enum": [
        "short",
        "average",
        "long"
       ]
      },
      "width": {
       "enum": [
        "narrow",
        "average",
        "wide"
       ]
      },
      "cleft": {
       "type": "boolean"
      }
     }
    },
    "eyes": {
     "enum": [
      "dark-brown",
      "brown",
      "hazel",
      "blue",
      "grey-blue"
     ]
    },
    "brows": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "color": {
       "$ref": "#/$defs/hairColor"
      },
      "weight": {
       "enum": [
        "fine",
        "average",
        "heavy"
       ]
      }
     }
    },
    "eyeShape": {
     "enum": [
      "average",
      "almond",
      "round",
      "hooded",
      "deep-set",
      "downturned",
      "upturned",
      "monolid"
     ]
    },
    "eyeBags": {
     "enum": [
      "none",
      "light",
      "heavy"
     ]
    },
    "mouth": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "width": {
       "enum": [
        "narrow",
        "average",
        "wide"
       ]
      },
      "lips": {
       "enum": [
        "thin",
        "average",
        "full"
       ]
      },
      "cupidsBow": {
       "enum": [
        "soft",
        "average",
        "defined"
       ]
      },
      "corners": {
       "enum": [
        "down",
        "neutral",
        "up"
       ]
      }
     }
    },
    "ears": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "size": {
       "enum": [
        "small",
        "average",
        "large"
       ]
      },
      "shape": {
       "enum": [
        "average",
        "round",
        "pointed",
        "square"
       ]
      },
      "angle": {
       "enum": [
        "flat",
        "average",
        "protruding"
       ]
      }
     }
    },
    "skull": {
     "type": "object",
     "additionalProperties": false,
     "properties": {
      "shape": {
       "enum": [
        "average",
        "oval",
        "round",
        "square",
        "long",
        "heart"
       ]
      },
      "back": {
       "enum": [
        "flat",
        "average",
        "full"
       ]
      }
     }
    },
    "forehead": {
     "enum": [
      "low",
      "average",
      "high",
      "sloped"
     ]
    },
    "eyeSpacing": {
     "enum": [
      "close",
      "average",
      "wide"
     ],
     "description": "how far apart the eyes sit (forge v2.5)"
    },
    "jawWidth": {
     "enum": [
      "narrow",
      "average",
      "wide"
     ],
     "description": "the jaw's width at its angle, under the ears (forge v2.5; 'jaw' is its shape)"
    },
    "faceLength": {
     "enum": [
      "short",
      "average",
      "long"
     ],
     "description": "the face's length, brow to chin (forge v2.5)"
    }
   }
  },
  "hair": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "style",
    "color"
   ],
   "properties": {
    "style": {
     "enum": [
      "shaved",
      "buzz",
      "short",
      "swept-back",
      "slicked",
      "short-curly",
      "curls",
      "bob",
      "bob-tucked",
      "long",
      "ponytail",
      "single-braid",
      "box-braids",
      "locs",
      "balding",
      "afro",
      "short-twists",
      "side-part",
      "long-straight",
      "high-ponytail",
      "bun"
     ]
    },
    "color": {
     "$ref": "#/$defs/hairColor"
    },
    "greying": {
     "type": "number",
     "minimum": 0,
     "maximum": 1,
     "description": "share of grey through the colour"
    }
   }
  },
  "facialHair": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "style"
   ],
   "properties": {
    "style": {
     "enum": [
      "none",
      "stubble",
      "moustache",
      "goatee",
      "short-boxed",
      "full-trimmed",
      "full",
      "chin-strap"
     ],
     "description": "stubble is painted; the rest are hair cards over a painted shadow (forge v2.2): moustache, goatee (moustache and chin), short-boxed (= full-trimmed: a short beard boxed along the cheeks), full (longer, further down the neck), chin-strap (a band along the jaw)"
    },
    "color": {
     "$ref": "#/$defs/hairColor"
    },
    "density": {
     "type": "number",
     "minimum": 0,
     "maximum": 1
    }
   }
  },
  "wardrobe": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "top",
    "bottom",
    "shoes"
   ],
   "properties": {
    "top": {
     "$ref": "#/$defs/garment",
     "description": "item: tee | long-sleeve | hoodie | puffer-coat | suit-jacket (single-breasted) | suit-jacket-db (double-breasted) | doorman-coat | uniform-jacket | chef-jacket | overalls (= dungarees: bib and straps over a tee; accent = the tee) | overcoat (overcoat = a knee-length coat over a shirt) | shirtless (a man only, a bare torso, only when the story asks for one)"
    },
    "bottom": {
     "$ref": "#/$defs/garment",
     "description": "item: jeans | ripped-jeans | trousers | loose-trousers | track-pants | skirt | suit-trousers (a suit or overalls top brings its own)"
    },
    "over": {
     "type": "array",
     "maxItems": 2,
     "items": {
      "$ref": "#/$defs/garment"
     },
     "description": "item: apron (pattern plain | check; tied at the back) | overcoat | puffer-coat | scarf (knit, wound at the neck, ends down the front; accent = stripes)"
    },
    "headwear": {
     "$ref": "#/$defs/garment",
     "description": "item: none | knit-beanie (pattern plain | stripe) | ball-cap | peaked-cap | hood-up (a hoodie's hood worn up; the hair goes under it)"
    },
    "shoes": {
     "$ref": "#/$defs/garment",
     "description": "item: dress | sneakers | white-sneakers | boots | work-boots | work-shoes | skate-shoes (sneakers and work boots are cut from the foot; accent = a sneaker's stripe and heel)"
    }
   }
  },
  "props": {
   "type": "array",
   "maxItems": 4,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind"
    ],
    "properties": {
     "kind": {
      "enum": [
       "glasses",
       "round-glasses",
       "earpiece",
       "cigar",
       "phone",
       "skateboard",
       "knife-roll",
       "cane"
      ]
     },
     "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
     }
    }
   },
   "description": "small objects made in code and fitted to the face/hands at runtime (Mog City's glasses/cigar pattern); the forge renders glasses today"
  },
  "posture": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "stance",
    "pace"
   ],
   "properties": {
    "stance": {
     "enum": [
      "upright",
      "relaxed",
      "slouched",
      "stooped",
      "proud",
      "guarded"
     ]
    },
    "pace": {
     "enum": [
      "slow",
      "steady",
      "quick",
      "restless"
     ]
    },
    "gestures": {
     "type": "string",
     "maxLength": 120,
     "description": "how they move their hands when they talk"
    },
    "idle": {
     "enum": [
      "idle",
      "arms",
      "phone",
      "shift",
      "leanBar",
      "drunkIdle"
     ],
     "description": "a clip from the shared pack"
    },
    "walk": {
     "enum": [
      "walk",
      "walkCool",
      "walkHeavy",
      "jog"
     ]
    }
   }
  },
  "personality": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "traits": {
     "type": "array",
     "maxItems": 5,
     "items": {
      "type": "string",
      "maxLength": 24
     }
    },
    "wants": {
     "type": "string",
     "maxLength": 120
    },
    "speech": {
     "type": "string",
     "maxLength": 160,
     "description": "how they talk: rhythm, words, accent described in words"
    }
   }
  },
  "voice": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "id"
   ],
   "properties": {
    "id": {
     "type": "string",
     "pattern": "^[a-z0-9-]{2,60}$",
     "description": "the voice this character speaks with, in the world's voice registry (generated per Create/Mog; real audio files, so face.js's jaw follows the level)"
    },
    "description": {
     "type": "string",
     "maxLength": 160
    },
    "pitch": {
     "enum": [
      "low",
      "mid-low",
      "mid",
      "mid-high",
      "high"
     ]
    },
    "rate": {
     "enum": [
      "slow",
      "steady",
      "quick"
     ]
    },
    "accent": {
     "type": "string",
     "maxLength": 40
    }
   }
  }
 },
 "$defs": {
  "hairColor": {
   "enum": [
    "black",
    "dark-brown",
    "brown",
    "light-brown",
    "auburn",
    "red",
    "dark-blonde",
    "blonde",
    "platinum",
    "salt-and-pepper",
    "grey",
    "silver",
    "white"
   ]
  },
  "garment": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "item"
   ],
   "properties": {
    "item": {
     "type": "string",
     "maxLength": 24
    },
    "color": {
     "type": "string",
     "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "accent": {
     "type": "string",
     "pattern": "^#[0-9A-Fa-f]{6}$",
     "description": "a second colour: a tie, a band, a trim, a check's second colour"
    },
    "pattern": {
     "enum": [
      "plain",
      "check",
      "stripe"
     ]
    },
    "fit": {
     "enum": [
      "fitted",
      "regular",
      "oversized"
     ]
    }
   }
  }
 }
}
